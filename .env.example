# Firebase 프로젝트 설정값을 여기에 채운 뒤, 파일명을 .env 로 바꿔주세요.
# (Firebase Console > 프로젝트 설정 > 일반 > 내 앱 > SDK 설정 및 구성)
#
# ⚠️ 값을 채우지 않으면 앱은 자동으로 "데모 모드"로 실행됩니다.
# (로그인/회원가입이 실제 인증 없이 흐름만 통과되고, 리포트/알림은 목업 데이터로 표시됩니다)

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# 웹 푸시(PWA, 아이폰 홈 화면 추가 포함)에 필요한 VAPID 공개키.
# `node scripts/generate-vapid-keys.js`로 키 쌍을 만든 뒤 "공개키"만 여기에 넣으세요.
# 개인키(VAPID_PRIVATE_KEY)는 절대 여기(클라이언트/저장소)에 넣지 말고,
# scripts/send-test-push.js를 실행할 때만 환경변수로 넘기세요. 자세한 내용은 README 참고.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
